<mujoco model="BR1 scene">
  <!-- Simulation scene = BR-1 robot + ground plane + lighting.
       Load THIS file for simulation/training/visualisation.
       (robot.xml on its own is also loadable, just with no floor.) -->

  <include file="robot.xml"/>

  <statistic center="0 0 0.6" extent="1.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.30 0.50 0.70" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.20 0.30 0.40" rgb2="0.10 0.20 0.30" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.15"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <!-- Flat, infinite ground. friction = INITIAL ASSUMPTION (rubber sole on
         lab floor). Domain randomisation will sweep 0.5 - 1.2 from Milestone 7. -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          condim="3" friction="1.0 0.005 0.0001"/>
  </worldbody>
</mujoco>
